{
  "name": "boms",
  "version": "0.0.1",
  "private": true,
  "description": "A Quasar Project",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "timothyisaiah <timothyisaiah7@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "dev:api": "node --env-file=.env.development --import tsx scripts/api-dev.ts",
    "typecheck": "tsc -p tsconfig.server.json",
    "test": "node --test tests/migrations.test.mjs tests/domain.test.mjs tests/users.test.mjs tests/partners.test.mjs tests/materials.test.mjs tests/variants.test.mjs tests/drafts.test.mjs tests/foundations.test.mjs tests/status.test.mjs tests/visual-tokens.test.mjs tests/simple-ops.test.mjs && node --import tsx --test tests/capabilities.test.mjs",
    "test:history": "node --import tsx --test tests/history.test.ts",
    "test:neon": "node --import tsx --test tests/neon.test.ts",
    "test:users:neon": "node --import tsx --test tests/users-neon.test.ts",
    "test:mobile": "playwright test",
    "test:browser": "playwright test",
    "test:responsive": "playwright test responsive",
    "test:a11y": "playwright test a11y",
    "neon:migrate": "node scripts/neon-migrate.mjs",
    "neon:seed": "node scripts/neon-seed.mjs",
    "neon:provision-user": "node scripts/neon-provision-user.mjs",
    "neon:repair-materials": "node scripts/repair-recipe-materials.mjs",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@quasar/extras": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "quasar": "^2.23.3",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@quasar/app-vite": "^3.3.0",
    "@types/node": "^22.20.2",
    "@vercel/node": "^12.0.3",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "postcss": "^8.5.8",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "beecone"
}
