# Server only. Never prefix database credentials with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require
CRON_SECRET=replace-with-at-least-32-random-characters
BOMS_ADMIN_EMAIL=owner@example.com
BOMS_ADMIN_PASSWORD=replace-with-a-unique-12-to-72-byte-password
BOMS_ADMIN_FULL_NAME=Beecone owner
BOMS_ADMIN_ROLE=admin_owner
